# Copy to .env and fill in. `.env` is gitignored; this file is not.
#
#   cp .env.example .env
#
# Loaded by `npm run dev`, `npm test` and the migrate/constraint scripts via
# Node's --env-file-if-exists. NOT loaded by `npm start`: in production the
# environment comes from the orchestrator, and a container that can silently
# fall back to a file on disk is a container whose configuration you cannot
# audit.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Any reachable Postgres 16. Docker is optional — `npm run verify:db` uses
# whatever answers on this URL and only starts a container if nothing does.
# Homebrew on macOS typically wants your own username and no password:
#   postgres://$(whoami)@localhost:5432/foodcourt?sslmode=disable
# Host ports for the docker-compose services. Set POSTGRES_PORT=5433 if you
# already run Postgres on 5432 — otherwise the app silently reaches YOUR
# server with the container's credentials and reports an auth failure.
POSTGRES_PORT=
REDIS_PORT=
DATABASE_URL=postgres://foodcourt:foodcourt@localhost:5432/foodcourt?sslmode=disable
REDIS_URL=redis://localhost:6379

# Signs staff and session tokens. 32 bytes, base64. Blank on purpose — the app
# refuses to boot without it, for the same reason as the tax flag below.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SIGNING_SEED=

# ---------------------------------------------------------------------------
# TAX DETERMINATION — INTENTIONALLY BLANK. THE APP WILL NOT BOOT UNTIL YOU SET IT.
#
# If you copied this file and `npm run dev` exited with code 78 saying
# TAX_SECTION_9_5_APPLIES is required: that is the design working, not a bug.
#
# If GST s.9(5) applies, the platform is the e-commerce operator liable for tax
# on the restaurant service, and must RETAIN the food GST rather than settle it
# to the vendor. A boolean quietly defaulting to false is how a platform
# overpays every vendor by ~5% of order value while earning ~3% commission —
# an error that compounds silently on every order and is discovered in
# reconciliation months later.
#
# So there is no default anywhere in the codebase, and there must not be one
# added to make a test pass. Set it in the test instead.
#
# For local development `true` is the useful choice: it is the harder path and
# exercises the tax-reserve code. It is NOT a determination.
# Owner: Finance plus an external CA. PRD v5.2 §4.7.
# ---------------------------------------------------------------------------
TAX_SECTION_9_5_APPLIES=

TAX_FOOD_GST_BPS=500
TAX_FEE_GST_BPS=1800

# ---------------------------------------------------------------------------
# PAYMENTS
#
# `stub` REFUSES TO CONSTRUCT IN PRODUCTION. It confirms payments nobody made,
# which in development is the point and in production is giving food away.
# The aggregator is still an open decision — PRD §19 row 2, §19.1 has the
# selection criteria.
#
# ON_ACKNOWLEDGED means authorise-then-capture: block the money at checkout,
# take it when the kitchen accepts, release it instantly if no stall ever does.
# The customer is never charged for food nobody agreed to make.
# ---------------------------------------------------------------------------
PAYMENTS_PROVIDER=stub
PAYMENTS_SPLIT_TIMING=ON_ACKNOWLEDGED

# Verifies inbound webhook signatures. Matches the stub's default so local
# development works; the production guard is that the stub cannot be built
# there at all.
PAYMENTS_WEBHOOK_SECRET=stub-secret

# ---------------------------------------------------------------------------
# CUSTOMER OTP
#
# `console` prints the code to the API log and delivers nothing. It is the only
# channel that works until DLT registration completes — India requires the
# sender entity, header and every template to be registered before
# transactional SMS is delivered, and that is calendar-bound.
#
# Setting this to `sms` fails at boot rather than silently telling every
# customer a code was sent. PRD §19 decision 1 — the item that blocks orders
# entirely, so it is the one to start first.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Where a stuck order wakes somebody up.
#
# E.164. Optional, and leaving it empty is a real choice with a real cost: the
# escalation ladder blocks a stall at 90 seconds and fails the order at 180, and
# with nobody from the platform in the building this is the only channel by
# which either fact reaches a human. Unset, every alert records a SKIPPED row
# saying there was nobody to send to — so "nobody was called" stays a fact in
# the table rather than an absence.
#
# Undeliverable until DLT registration completes, exactly like customer OTP.
OPS_ONCALL_PHONE=

OTP_CHANNEL=console
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5

# An unauthenticated endpoint that spends money on an SMS per call. These are
# the limits that stop a stranger spending it.
OTP_SEND_PER_PHONE_PER_HOUR=5
OTP_SEND_PER_IP_PER_HOUR=20

DISPATCH_LADDER_STEP1_SECONDS=15
DISPATCH_LADDER_STEP2_SECONDS=45
DISPATCH_LADDER_STEP3_SECONDS=90
DISPATCH_LADDER_STEP4_SECONDS=180

DEVICE_HEARTBEAT_INTERVAL_SECONDS=15
DEVICE_OFFLINE_THRESHOLD_SECONDS=60

# The letter in "A-001". Give every deployment sharing a food court a
# different one — otherwise two independent instances both start at A-001
# and collide the moment their data is merged. See src/ordering/order.repository.ts.
ORDER_NUMBER_PREFIX=A

# --------------------------------------------------------- offline sync (demo)
#
# `off` (default): the sync module never starts, every existing environment
# is unaffected. `cloud`: the always-online instance — stays subscribed,
# answers whatever an edge device asks for. `edge`: the instance that is
# normally cut off from the internet and gets a short connectivity window to
# sync through Ably.
#
# ABLY_API_KEY authenticates this process's own connection to Ably; it is
# never sent to a browser. Use a capability-restricted key per device (an
# Ably-dashboard setting), not the account root key.
SYNC_MODE=off
# SYNC_DEVICE_ID=demo-edge-1        # required when SYNC_MODE=edge — this device's own id
# SYNC_EDGE_DEVICE_IDS=demo-edge-1  # required when SYNC_MODE=cloud — comma-separated
# ABLY_API_KEY=
# DEMO-ONLY: forces the edge connectivity probe to report unreachable
# without touching the network, so "hotspot on/off" can be simulated by
# flipping this and restarting the worker.
# SYNC_FORCE_OFFLINE=true

# ---------------------------------------------------------------- image storage
#
# Cloudinary today; a local server later. All three are OPTIONAL — the platform
# boots without them and simply refuses image uploads with a message naming
# these variables. Orders, payments and the kitchen board do not depend on
# photographs, and refusing to start over a decorative feature would be wrong.
#
# THE SECRET IS SIGNING MATERIAL. It never leaves the API process: it signs
# uploads the browser then performs directly against Cloudinary. It is not sent
# to any client, not logged, and not in any response.
#
# The cloud NAME is public — it appears in every image URL the app serves.
# The KEY and SECRET are not. Put the real values in .env, which is gitignored.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI dish descriptions ----------------------------------------------------
# Both optional. With neither set the feature reports itself as unavailable and
# the kitchen board hides the button — the API still boots and every other
# screen is unaffected.
#
# Grok answers first; OpenRouter's Nemotron answers when it does not. Setting
# only one is a valid configuration, it just has no spare engine.
#
# Neither key is ever sent to a client or written to a log.
# --- Cashfree payments ---------------------------------------------------------
# Sandbox and production issue DIFFERENT credentials. CASHFREE_ENV is its own
# variable rather than inferred from NODE_ENV, because inferring it is one
# character away from taking real money in a staging environment.
#
# Only needed when PAYMENTS_PROVIDER=cashfree. The default (stub) needs none of
# it, and selecting cashfree without them fails at BOOT naming the missing one.
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=
# WEBHOOKS ONLY. Absolute https URL that CASHFREE can reach, server to server —
# so it cannot be localhost, and local webhook testing needs a tunnel. Absent,
# no webhook arrives and the server learns outcomes by polling `getStatus`
# instead: slower, never wrong.
CASHFREE_PUBLIC_BASE_URL=
# WHERE THE CUSTOMER'S BROWSER RETURNS after paying. Different requirement — it
# only has to be reachable from their own device, so localhost is fine.
#
# Leave it blank in development: the provider falls back to
# http://localhost:5173, the PWA's dev server. Set it in production to the
# customer app's real origin.
#
# It matters more than it looks. Cashfree's v3 checkout REFUSES TO RENDER for
# an order with no return_url, and this used to be gated on the webhook URL
# above — so with no tunnel, local checkout could not work at all and said only
# "Something went wrong".
CASHFREE_RETURN_BASE_URL=

XAI_API_KEY=
OPENROUTER_API_KEY=
# Optional overrides; the defaults are in src/platform/config.ts.
# Defaults: grok-4.6 and nvidia/nemotron-3.5-lightning
XAI_MODEL=
OPENROUTER_MODEL=
