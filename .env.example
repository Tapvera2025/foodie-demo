# Copy to .env and fill in. `.env` is gitignored; this file is not.
#
#   cp .env.example .env
#
# Loaded by `npm run dev`, `npm test` and the migrate/constraint scripts via
# Node's --env-file-if-exists. NOT loaded by `npm start`: in production the
# environment comes from the orchestrator, and a container that can silently
# fall back to a file on disk is a container whose configuration you cannot
# audit.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Any reachable Postgres 16. Docker is optional — `npm run verify:db` uses
# whatever answers on this URL and only starts a container if nothing does.
# Homebrew on macOS typically wants your own username and no password:
#   postgres://$(whoami)@localhost:5432/foodcourt?sslmode=disable
DATABASE_URL=postgres://foodcourt:foodcourt@localhost:5432/foodcourt?sslmode=disable
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# TAX DETERMINATION — INTENTIONALLY BLANK. THE APP WILL NOT BOOT UNTIL YOU SET IT.
#
# If you copied this file and `npm run dev` exited with code 78 saying
# TAX_SECTION_9_5_APPLIES is required: that is the design working, not a bug.
#
# If GST s.9(5) applies, the platform is the e-commerce operator liable for tax
# on the restaurant service, and must RETAIN the food GST rather than settle it
# to the vendor. A boolean quietly defaulting to false is how a platform
# overpays every vendor by ~5% of order value while earning ~3% commission —
# an error that compounds silently on every order and is discovered in
# reconciliation months later.
#
# So there is no default anywhere in the codebase, and there must not be one
# added to make a test pass. Set it in the test instead.
#
# For local development `true` is the useful choice: it is the harder path and
# exercises the tax-reserve code. It is NOT a determination.
# Owner: Finance plus an external CA. PRD v5.2 §4.7.
# ---------------------------------------------------------------------------
TAX_SECTION_9_5_APPLIES=

TAX_FOOD_GST_BPS=500
TAX_FEE_GST_BPS=1800

PAYMENTS_PROVIDER=stub
PAYMENTS_SPLIT_TIMING=ON_ACKNOWLEDGED

DISPATCH_LADDER_STEP1_SECONDS=15
DISPATCH_LADDER_STEP2_SECONDS=45
DISPATCH_LADDER_STEP3_SECONDS=90
DISPATCH_LADDER_STEP4_SECONDS=180

DEVICE_HEARTBEAT_INTERVAL_SECONDS=15
DEVICE_OFFLINE_THRESHOLD_SECONDS=60
