{
  "name": "foodcourt-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Food Court QR Ordering Platform \u2014 API and worker",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/workers/index.js",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --dir src",
    "test:property": "vitest run --dir tests/property",
    "test:integration": "vitest run --dir tests/integration",
    "test:coverage:financial": "vitest run --coverage",
    "test:constraints": "node --env-file-if-exists=.env --import tsx scripts/test-constraints.ts",
    "migrate:up": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts up",
    "codegen:api": "openapi-typescript contracts/openapi.yaml -o src/generated/api.d.ts",
    "check:req-ids": "node scripts/check-req-ids.js",
    "verify:db": "bash scripts/verify-db.sh",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "migrate:status": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts status",
    "db:doctor": "bash scripts/db-doctor.sh"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "jose": "^6.2.8",
    "kysely": "^0.27.4",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@noble/hashes": "^2.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.5",
    "eslint": "^9.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.0.0",
    "fast-check": "^3.23.1",
    "globals": "^17.9.0",
    "openapi-typescript": "^7.4.4",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.5"
  }
}
