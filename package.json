{
  "name": "foodcourt-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "description": "Food Court QR Ordering Platform — API and worker",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/workers/index.js",
    "dev:worker": "node --env-file-if-exists=.env --import tsx --watch src/workers/index.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @foodcourt/pwa && npm run typecheck --workspace @foodcourt/kds && npm run typecheck --workspace @foodcourt/admin",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --dir src",
    "test:property": "vitest run --dir tests/property",
    "test:integration": "vitest run --dir tests/integration",
    "test:coverage:financial": "vitest run --coverage",
    "test:constraints": "node --env-file-if-exists=.env --import tsx scripts/test-constraints.ts",
    "test:auth": "node --env-file-if-exists=.env --import tsx scripts/test-auth.ts",
    "test:notify": "node --env-file-if-exists=.env --import tsx scripts/test-notify.ts",
    "test:refund": "node --env-file-if-exists=.env --import tsx scripts/test-refund.ts",
    "test:menu": "node --env-file-if-exists=.env --import tsx scripts/test-menu.ts",
    "test:design": "node tests/design/contrast.mjs && node tests/design/tokens.mjs",
    "migrate:up": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts up",
    "codegen:api": "openapi-typescript contracts/openapi.yaml -o src/generated/api.d.ts",
    "check:req-ids": "node scripts/check-req-ids.js",
    "demo:order": "node --env-file-if-exists=.env --import tsx scripts/demo-order.ts",
    "seed:dev": "node --env-file-if-exists=.env --import tsx scripts/seed-dev.ts",
    "verify:db": "bash scripts/verify-db.sh",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "migrate:status": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts status",
    "db:doctor": "bash scripts/db-doctor.sh",
    "dev:pwa": "npm run dev --workspace @foodcourt/pwa",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:clean": "node scripts/dev-all.mjs --clear-ports",
    "build:pwa": "npm run build --workspace @foodcourt/pwa",
    "dev:kds": "npm run dev --workspace @foodcourt/kds",
    "seed:orders": "node --env-file-if-exists=.env --import tsx scripts/seed-orders.ts",
    "reset:orders": "node --env-file-if-exists=.env --import tsx scripts/reset-orders.ts",
    "build:kds": "npm run build --workspace @foodcourt/kds",
    "setup": "npm run migrate:up && npm run seed:dev",
    "dev:admin": "npm run dev --workspace @foodcourt/admin",
    "build:admin": "npm run build --workspace @foodcourt/admin",
    "test:authz": "node tests/conformance/console-authz.mjs",
    "test:contract": "node tests/conformance/client-contract.mjs",
    "verify": "npm run typecheck && npm run test:authz && npm run test:contract && npm run test:chips && npm run test:routes && npm run test:urls && npm run test:orders && npm run test:rail && npm run test:handoff && npm run test:realtime && npm run test:polling && npm run test:musttry && npm run test:ai && npm run test:money && npm run test:split && npm run test:scriptdb && npm run test:docs && npm run test:sw && npm run test:counter && npm run test:design",
    "test:docs": "node tests/conformance/tech-doc.mjs",
    "diagnose:payment": "node --env-file-if-exists=.env --import tsx scripts/diagnose-payment.ts",
    "diagnose:offers": "node --env-file-if-exists=.env --import tsx scripts/diagnose-offers.ts",
    "diagnose:schema": "node --env-file-if-exists=.env --import tsx scripts/diagnose-schema.ts",
    "diagnose:customer": "node --env-file-if-exists=.env --import tsx scripts/diagnose-customer.ts",
    "check:uploads": "node --env-file-if-exists=.env --import tsx scripts/check-uploads.ts",
    "test:chips": "node --experimental-strip-types tests/conformance/category-chips.mjs",
    "test:routes": "node tests/conformance/customer-routes.mjs",
    "test:ai": "node --experimental-strip-types tests/conformance/ai-descriptions.mjs",
    "test:cashfree": "node --env-file-if-exists=.env --import tsx scripts/test-cashfree.ts",
    "test:money": "node --experimental-strip-types tests/conformance/cashfree-money.mjs",
    "test:urls": "node tests/conformance/outbound-urls.mjs",
    "test:sw": "node tests/conformance/sw-cache-policy.mjs",
    "test:counter": "node tests/conformance/counter-identity.mjs",
    "diagnose:cashfree": "node --env-file-if-exists=.env --import tsx scripts/diagnose-cashfree.ts",
    "test:orders": "node tests/conformance/order-numbering.mjs",
    "diagnose:scope": "node --env-file-if-exists=.env --import tsx scripts/diagnose-order-scope.ts",
    "test:rail": "node tests/conformance/track-rail.mjs",
    "diagnose:images": "node --env-file-if-exists=.env --import tsx scripts/diagnose-images.ts",
    "test:handoff": "node tests/conformance/pay-handoff.mjs",
    "test:realtime": "node tests/conformance/realtime-rooms.mjs",
    "test:polling": "node tests/conformance/no-hot-polling.mjs",
    "diagnose:session": "node --env-file-if-exists=.env --import tsx scripts/diagnose-session.ts",
    "probe:checkout": "node --env-file-if-exists=.env --import tsx scripts/probe-checkout.ts",
    "test:musttry": "node tests/conformance/must-try.mjs",
    "test:split": "node --experimental-strip-types tests/conformance/split.mjs",
    "split:setup": "node --env-file-if-exists=.env --import tsx scripts/split-setup.ts",
    "diagnose:split": "node --env-file-if-exists=.env --import tsx scripts/diagnose-split.ts",
    "test:scriptdb": "node tests/conformance/script-db.mjs",
    "sync:bootstrap": "node --env-file-if-exists=.env --import tsx scripts/sync-bootstrap.ts",
    "sync:run": "node --env-file-if-exists=.env --import tsx scripts/sync-run.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "ably": "^2.6.4",
    "jose": "^6.2.8",
    "kysely": "^0.27.4",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@noble/hashes": "^2.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.5",
    "eslint": "^9.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.0.0",
    "fast-check": "^3.23.1",
    "globals": "^17.9.0",
    "openapi-typescript": "^7.4.4",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.5"
  }
}
