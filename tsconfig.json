{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,

    /* Nest DI needs both of these. esbuild cannot do emitDecoratorMetadata,
       which is why decorated classes are compiled by tsc and unit tests are
       kept on the pure modules. See docs/tech/tooling.md. */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    /* docs/tech/backend.md — strictness is not negotiable in a financial system. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist", "apps"]
}
